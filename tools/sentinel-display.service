[Unit]
Description=BlackBox Sentinel — Physical Console Status Display
After=sentinel.service
Wants=sentinel.service

[Service]
Type=simple
ExecStart=/bin/bash /home/sentinel/Blackbox_Sentinel/tools/console_display.sh
StandardInput=tty
StandardOutput=tty
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
