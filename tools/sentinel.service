[Unit]
Description=BlackBox Sentinel — Headless Flask Orchestrator
# Headless mode: no display required. Access UI at http://<pi-ip>:5000
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/home/sentinel/Blackbox_Sentinel
Environment=SENTINEL_HARDWARE=hw
Environment=SENTINEL_ED25519_KEY=pTzAdlRSVMXTi2PNIXM1BiONgTEHAxyea2wxPEoR-0Q
Environment=PYTHONUNBUFFERED=1
ExecStart=/bin/bash /home/sentinel/Blackbox_Sentinel/tools/start_sentinel.sh
Restart=always
RestartSec=5
StartLimitIntervalSec=600
StartLimitBurst=50

# Security Hardening
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/home/sentinel/Blackbox_Sentinel/logs_and_data /home/sentinel/Blackbox_Sentinel/m3-ml-ledger /tmp /home/sentinel/.local

[Install]
WantedBy=multi-user.target
