[Unit]
Description=BlackBox Sentinel Network Monitor
After=network.target

[Service]
Type=simple
User=sentinel
WorkingDirectory=/opt/blackbox-sentinel
ExecStart=/opt/blackbox-sentinel/venv/bin/python /opt/blackbox-sentinel/sentinel_pipeline.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
