{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "🚀 Run Sentinel Pipeline (Sim Mode + GUI)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/sentinel_pipeline.py",
            "args": ["--mode", "sim", "--gui"],
            "console": "integratedTerminal"
        },
        {
            "name": "🌐 Start Ubuntu Web Kiosk & 3D CAD Studio (Port 8080)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/m4-gui-venture/server.py",
            "console": "integratedTerminal"
        },
        {
            "name": "⚡ Start Hardware Bridge Simulator Server (Port 5000)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/m4-gui-venture/hw_simulator_server.py",
            "console": "integratedTerminal"
        },
        {
            "name": "🧠 Train Isolation Forest & Ledger (M3)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/m3-ml-ledger/src/train.py",
            "console": "integratedTerminal"
        },
        {
            "name": "🔬 Run Pytest Suite",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": ["-v"],
            "console": "integratedTerminal"
        }
    ]
}
